# ===== 复制为 .env 后填写真实值（.env 已被 gitignore，绝不提交）=====

# ---- DeepSeek（单一模型；各调用点思考强度见 config/default.json 的 model.efforts）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com      # 规范地址无 /v1；带 /v1 也兼容
DEEPSEEK_MODEL=deepseek-flash          # 最新模型；用户可自行改
DEEPSEEK_THINKING=1                    # 思考模式开关（1=开）
DEEPSEEK_REASONING_EFFORT=high         # 缺省档（none/minimal/low/medium/high/xhigh/max）

# 本地 2B（llama.cpp / Ollama 的 OpenAI 兼容端点；初期可空，后续降成本时接）
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=minicpm5-2b

# QQ / OneBot（NapCat 运行时的端点；QQ_MASTER/QQ_ALLOWED 白名单已废弃——身份由 .create/.link 绑定）
NAPCAT_URL=ws://127.0.0.1:3001
NAPCAT_TOKEN=

# ---- 通道收发开关（可用通道：feishu / onebot / bark）----
# 旧 INPUT_DRIVER/OUTPUT_DRIVER 单通道写法仍兼容；未配置时按凭据推导（FEISHU_APP_ID 优先）
INPUT_CHANNELS=feishu
OUTPUT_CHANNELS=feishu
MASTER_UID=me                  # 默认身份（小写字母开头，仅小写字母/数字/下划线，≤16 字符）；通道端点须 .create/.link 绑定

# ---- 飞书（自建应用机器人）----
# 权限（应用身份列）：im:message:send_as_bot、im:message.p2p_msg:readonly、im:resource、
#                     contact:contact.base:readonly（可选，解析 open_id 用）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ---- Bark（可选出站；设备 token 经 .link bark <token> 绑定，不进 env）----
# BARK_URL=https://api.day.app

# ---- 运行开关（可选）----
# DEBUG_CLI=1                    # 显式开启 stdin 调试台（默认关闭；正常运行终端只输出、不接收指令）
# CONNECT_RETRY_INTERVAL=30      # 启动强依赖：等通道连接的重试提醒间隔（秒）
# COMPACT_HINT_TURNS=100         # 软压缩提醒阈值：对话轮数达此值提醒一次 .compact（0=关闭）

# 主动关怀（人文关怀触达）频率治理（env 可调，缺省用默认值）
PROACTIVE_DAILY_TARGET=6       # 每天期望触达次数（据此反推动每分钟概率 p=TARGET/1440）
PROACTIVE_DAILY_CAP=8          # 每日实际外发上限（确定性刹车，防连发超预期）
PROACTIVE_MIN_INTERVAL=45      # 距上次外发的最小间隔（分钟）

# 其余私有配置（提醒 / 角色扮演提示词等）按需放到这里

# ---- per-uid 信息库（自包含迁移，无 env 配置）----
# 全部在 data/<uid>/ 家目录下：persona.md 人设、mech_prompts.json 机械提示
# （缺省回退 prompts/mech_prompts_baseline.json）、uid.json 身份端点（.create 生成）、
# items/expenses/session/usage 运行态 + attachments 附件。
# 拷贝整个 data/<uid>/ 目录即可把一个人全部信息迁移到另一台设备。
# （旧 PERSONA / CHARACTER_CARD / MECH_PROMPTS env 机制已删除。）

# ---- 语音输出（TTS，英文音色，见 tts/）----
# 默认开启：仅当模型输出 <voice> 标签时触发合成，不影响纯文本对话。
# TTS_ENABLED=1
# TTS_BACKEND=subprocess          # subprocess=调 tts/infer_launcher.py；service=常驻 OpenAI 兼容 /v1/audio/speech
# TTS_SERVICE_URL=                # TTS_BACKEND=service 时的端点，如 http://127.0.0.1:8000/v1
# TTS_VOICE=calm                  # 默认音色：ref_voice_bank 下的 calm/sad/angry
# TTS_DEVICE=cuda                 # 推理设备（GPU 被占用时用 cpu）
# TTS_TIMEOUT=180                 # 语音生成超时（秒）
